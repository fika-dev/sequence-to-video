GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_PROJECT_ID=your_google_project_id_here
GCS_BUCKET=your_gcs_bucket_name_here

# Content Engine (required for content_engine strategy)
# Can use either GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=your-gemini-api-key
# OR use GOOGLE_API_KEY (will be used as fallback if GEMINI_API_KEY not set)
# GOOGLE_API_KEY=your-google-api-key

# Content Engine (optional - for enhanced functionality)
YOUTUBE_API_KEY=your-youtube-api-key
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
